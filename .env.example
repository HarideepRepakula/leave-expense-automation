# Copy this file to .env and fill in values. Never commit .env.
# All values below are DEVELOPMENT placeholders for a local, synthetic-data database.

# --- PostgreSQL (Docker Compose or local install) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Migrator / owner role (used by Alembic and by docker-compose as the superuser of the container)
POSTGRES_MIGRATOR_USER=lea_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator

# Application role (FastAPI, generator loader). INSERT/SELECT only on append-only tables.
POSTGRES_APP_USER=lea_app
POSTGRES_APP_PASSWORD=change-me-app

# Read-only analytics role (Streamlit). SELECT on ops views only.
POSTGRES_ANALYTICS_USER=lea_analytics_ro
POSTGRES_ANALYTICS_PASSWORD=change-me-analytics

# Evaluation role. SELECT on ops AND ground_truth. Used only by src/evaluation.
POSTGRES_EVALUATION_USER=lea_evaluation
POSTGRES_EVALUATION_PASSWORD=change-me-evaluation

# Database names
POSTGRES_DEV_DB=lea_dev
POSTGRES_TEST_DB=lea_test

# Full URLs (derived; override if you use a non-default host or port)
DATABASE_URL=postgresql+psycopg://lea_migrator:change-me-migrator@localhost:5432/lea_dev
TEST_DATABASE_URL=postgresql+psycopg://lea_migrator:change-me-migrator@localhost:5432/lea_test

# --- Simulated time (amendment A7). Never use the wall clock in rules or generation. ---
AS_OF_DATE=2026-10-22

# --- Simulated authentication (Phase 9) ---
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_MINUTES=480

# --- Optional LLM explanation layer (DEC-29). Off by default. Display-only rewording. ---
LLM_EXPLANATIONS_ENABLED=false
GROQ_API_KEY=
